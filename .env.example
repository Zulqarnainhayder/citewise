# Copy this file to .env.local and fill in the values. Never commit real keys.

# Google AI Studio key (https://aistudio.google.com). Server only: it is never sent to the browser.
GOOGLE_API_KEY=

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Safe for the browser because row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the Gemini model that writes answers. Defaults to gemini-3.5-flash-lite.
# GEMINI_CHAT_MODEL=

# Optional: per-user usage limits that protect the shared AI quota (defaults shown).
# CHAT_LIMIT_PER_MINUTE=6
# CHAT_LIMIT_PER_DAY=50
# DOCUMENT_LIMIT_PER_DAY=10
